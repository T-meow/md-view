{
  "name": "md-view",
  "version": "1.2.0",
  "description": "Local Markdown reader and editor built with Tauri and Svelte.",
  "license": "WTFPL",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:plus",
    "dev:lite": "vite --config vite.app.config.mjs --host 127.0.0.1 --port 1420 --mode lite",
    "dev:plus": "vite --config vite.app.config.mjs --host 127.0.0.1 --port 1420 --mode plus",
    "build": "npm run build:plus",
    "build:lite": "vite build --config vite.app.config.mjs --mode lite",
    "build:plus": "vite build --config vite.app.config.mjs --mode plus",
    "build:web": "node scripts/build-web.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:play": "vite build --config vite.app.config.mjs --mode web-plus --outDir dist-play",
    "test": "vitest run",
    "check:web": "node scripts/check-web.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:editions": "node scripts/check-editions.mjs",
    "tauri": "tauri",
    "tauri:dev": "npm run tauri:dev:plus",
    "tauri:dev:lite": "tauri dev -c src-tauri/tauri.lite.conf.json",
    "tauri:dev:plus": "tauri dev -c src-tauri/tauri.plus.conf.json",
    "tauri:build": "npm run tauri:build:plus",
    "tauri:build:lite": "node scripts/tauri-build-edition.mjs lite",
    "tauri:build:plus": "node scripts/tauri-build-edition.mjs plus",
    "tauri:build:both": "npm run tauri:build:lite && npm run tauri:build:plus",
    "tauri:build:all": "tauri build",
    "tauri:build:no-bundle": "tauri build --no-bundle"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.13",
    "lucide-svelte": "^1.0.0",
    "marked": "^15.0.7",
    "mermaid": "^11.16.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "svelte": "^5.56.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.2",
    "@tsconfig/svelte": "^5.0.4",
    "esbuild": "^0.27.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "svelte-check": "^4.1.4",
    "tslib": "^2.8.1",
    "typescript": "^5.8.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
